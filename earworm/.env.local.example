# Copy this file to .env.local and fill in what you need. Everything here is
# optional — the game runs without any of it, just with fewer features.
# Restart `npm run dev` after changing this file.

# --- Spotify import (optional) ---
# Lets you import your Liked Songs and Top Tracks. Get a Client ID at
# https://developer.spotify.com/dashboard (see README for full steps).
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_client_id_here

# --- Accounts / cross-device sync (optional) ---
# Enables "Sign in with Google" and saves your imports, lists, and stats to
# your account. Both values come from your Supabase project
# (Project Settings → API). See README for the full setup.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Apple Music affiliate (optional) ---
# Credits "Listen on Apple Music" clicks to your affiliate account. Get the
# `at` token by joining Apple's Services Performance Partners Program. Without
# it, the links still work — they're just not monetized.
NEXT_PUBLIC_APPLE_AFFILIATE_TOKEN=your_apple_at_token
# Optional label for traffic from this game (defaults to "earworm").
NEXT_PUBLIC_APPLE_CAMPAIGN_TOKEN=earworm

# --- Donations (optional) ---
# The footer "Buy me a coffee" link. Defaults to the project's page in code;
# override here with your own username/URL, or set it empty to hide the link.
NEXT_PUBLIC_BUYMEACOFFEE=your_bmc_username
